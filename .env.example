# Copy to .env for local experiments. Do not commit .env.
# Generate a real secret with: openssl rand -hex 16
PORT=8080
MCP_PATH_SECRET=replace-with-openssl-rand-hex-16
RECOGNIZERS=shazam
# ALLOW_INSECURE_NO_SECRET=1

# Optional paid fallbacks. Leave unset to keep the free Shazam backend only.
# AUDD_API_TOKEN=
# ACR_HOST=identify-eu-west-1.acrcloud.com
# ACR_ACCESS_KEY=
# ACR_ACCESS_SECRET=
